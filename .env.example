# Server-side only. Copy to .env.local and fill securely; never commit real values.
TAVILY_API_KEY=
AI_GATEWAY_API_KEY=
# Optional model override: an AI Gateway model ID with structured-output support.
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
# Required in production, optional locally: a private access code (20+ characters).
# Enter this code in the research panel; it stays in page memory and is sent only to this app.
RESEARCH_ACCESS_TOKEN=
# Prevent Next.js CLI telemetry during local development/builds.
NEXT_TELEMETRY_DISABLED=1
